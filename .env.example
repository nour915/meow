# انسخ هذا الملف إلى .env.local (تطوير محلي) أو ضع القيم في Vercel → Settings → Environment Variables

# قاعدة Turso (إلزاميان) — أنشئها مجانًا عبر: turso db create <name> ثم turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# عنوان خدمة دمج الفيديو (مشروع video-merger داخل هذا المستودع بعد نشره على Vercel)
MERGER_API_BASE=https://<your-video-merger>.vercel.app

# اختياري: إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
